# PAPA PIZZA V5.5 — acoes nativas diretas; execucao corrigida pendente no iPhone.
# Cadastro original somente leitura. Nenhuma funcao auxiliar ou condicao composta.
shortcut:
  modo = "SAIR"
  menu("PAPA PIZZA | Conferencia"):
    case "NOVA CONFERÊNCIA":
      modo = "NOVA"
    case "CONTINUAR CONFERÊNCIA":
      modo = "CONTINUAR"
    case "GERAR RESUMO":
      modo = "RESUMO"
    case "SAIR":
      modo = "SAIR"
  if modo == "SAIR":
    flow.stop()

  alert("Selecione a pasta V5 em iCloud Drive/Atalhos/PAPA PIZZA/V5. Ela deve conter Conferencias, Backups e Resumos. Use sempre esta mesma pasta.", title: "Pastas prontas")
  bases = files.choose(picking_mode: "Folders", select_multiple: false)
  base = item(bases, at: 1)
  if base has no value:
    flow.stop()
  pastasConferencias = files.open(folder: base, path: "Conferencias", folder_contents: false, error_if_missing: true, show_picker: false)
  pasta = item(pastasConferencias, at: 1)
  pastasBackups = files.open(folder: base, path: "Backups", folder_contents: false, error_if_missing: true, show_picker: false)
  backups = item(pastasBackups, at: 1)
  pastasResumos = files.open(folder: base, path: "Resumos", folder_contents: false, error_if_missing: true, show_picker: false)
  resumos = item(pastasResumos, at: 1)
  ordem = list(["18", "53", "59", "31", "12", "6", "37", "38", "36", "56", "55", "49", "33", "32", "3", "7", "24", "13", "19", "25", "57", "41", "44", "40", "43", "47", "8", "46", "26", "54", "50", "5", "21", "42", "45", "35", "9", "34", "29", "1", "2", "27", "20", "48", "30", "28", "17", "60", "23", "11", "15", "4", "22", "52", "10", "14", "16", "39", "51", "58"])
  nomesOrdenados = list(["Abacaxi Picado", "Açúcar", "Álcool", "Alho Frito", "Alho Poró Fatiado", "Bacon Frito", "Bobina Grande", "Bobina Impressora", "Bobina Pequena", "Bombril", "Bucha", "Cachaça", "Caixa 30", "Caixa 35", "Calabresa Fatiada", "Carne Seca", "Catupiry", "Cebola Fatiada", "Champignon", "Cheddar", "Cloro", "Coca Normal 1,5", "Coca Normal 600", "Coca Zero 1,5", "Coca Zero 600", "Coloral", "Costela", "Creme de Alho", "Creme De Leite", "Detergente", "Fermento", "Frango Temperado", "Gorgonzola", "Guaraná 1,5", "Guaraná 600", "Ketchup", "Lombo Fatiado", "Maionese", "Manjericão", "Massa", "Molho", "Molho Barbecue", "Muçarela Ralada", "Óleo", "Orégano", "Ovo Cozido", "Palmito", "Papel Toalha", "Parmesão", "Pepperoni", "Pimentão Picado", "Presunto Fatiado", "Provolone", "Sal", "Salaminho", "Tomate Picado", "Tomate Seco", "Touca", "Trigo", "Veja"])
  referencia = data({"1": "Massa", "2": "Molho", "3": "Calabresa Fatiada", "4": "Presunto Fatiado", "5": "Frango Temperado", "6": "Bacon Frito", "7": "Carne Seca", "8": "Costela", "9": "Lombo Fatiado", "10": "Salaminho", "11": "Pepperoni", "12": "Alho Poró Fatiado", "13": "Cebola Fatiada", "14": "Tomate Picado", "15": "Pimentão Picado", "16": "Tomate Seco", "17": "Palmito", "18": "Abacaxi Picado", "19": "Champignon", "20": "Muçarela Ralada", "21": "Gorgonzola", "22": "Provolone", "23": "Parmesão", "24": "Catupiry", "25": "Cheddar", "26": "Creme De Leite", "27": "Molho Barbecue", "28": "Ovo Cozido", "29": "Manjericão", "30": "Orégano", "31": "Alho Frito", "32": "Caixa 35", "33": "Caixa 30", "34": "Maionese", "35": "Ketchup", "36": "Bobina Pequena", "37": "Bobina Grande", "38": "Bobina Impressora", "39": "Touca", "40": "Coca Zero 1,5", "41": "Coca Normal 1,5", "42": "Guaraná 1,5", "43": "Coca Zero 600", "44": "Coca Normal 600", "45": "Guaraná 600", "46": "Creme de Alho", "47": "Coloral", "48": "Óleo", "49": "Cachaça", "50": "Fermento", "51": "Trigo", "52": "Sal", "53": "Açúcar", "54": "Detergente", "55": "Bucha", "56": "Bombril", "57": "Cloro", "58": "Veja", "59": "Álcool", "60": "Papel Toalha"})
  cadastro = data({})
  registros = data({})
  identificador = ""
  inicio = ""
  estado = "ABERTA"
  origem = ""
  nomeSessao = ""
  ultimoJson = ""
  ultimoHash = ""
  arquivoPrincipal = null
  recuperar = "NAO"
  precisaSalvar = "NAO"
  operacao = "MENU"
  totalConferidos = 0

  if modo == "NOVA":
    alert("Selecione o cadastro original Papa_Pizza.json no iCloud Drive. Ele sera apenas lido.", title: "Cadastro")
    arquivosCadastro = files.choose(picking_mode: "Files", select_multiple: false)
    arquivoCadastro = item(arquivosCadastro, at: 1)
    partesCadastro = text.detect(input: arquivoCadastro)
    textoCadastro = combine(partesCadastro, separator: "")
    cadastroBruto = data.decode_json(input: textoCadastro)
    cadastro = as_type(cadastroBruto, "Dictionary")
    precisaSalvar = "SIM"
    operacao = "INICIAR"
  else:
    pastaLeitura = pasta
    if modo == "CONTINUAR":
      menu("Origem da retomada"):
        case "ARQUIVO PRINCIPAL":
          recuperar = "NAO"
        case "RECUPERAR BACKUP":
          recuperar = "SIM"
          pastaLeitura = backups
    arquivosHistorico = files.contents(folder: pastaLeitura)
    ordenados = files.filter(items: arquivosHistorico, sort_by: "Name", order: "Descending")
    recentes = list([])
    anteriores = list([])
    quantidadeHistorico = 0
    for item in ordenados:
      candidato = item
      partesNome = files.name(item: candidato)
      nome = combine(partesNome, separator: "")
      extensaoCandidato = files.detail(file: candidato, property: "File Extension")
      partesExtensaoCandidato = text.detect(input: extensaoCandidato)
      extensaoHistorico = combine(partesExtensaoCandidato, separator: "")
      if extensaoHistorico == "json":
        nomeCompleto = "NAO"
        if nome ends with ".json":
          nomeCompleto = "SIM"
        if nomeCompleto == "NAO":
          nome = text("\(nome).json")
      if extensaoHistorico == "json":
        if nome starts with "Conferencia_":
          if nome ends with ".json":
            quantidadeHistorico = quantidadeHistorico + 1
            if quantidadeHistorico <= 5:
              variables.append(name: "recentes", value: nome)
            else:
              variables.append(name: "anteriores", value: nome)
    if quantidadeHistorico == 0:
      alert("Nao ha arquivos nesta pasta. O historico das versoes anteriores permanece na pasta antiga.", title: "Historico V5")
      flow.stop()
    listaHistorico = recentes
    if quantidadeHistorico > 5:
      menu("Historico"):
        case "CINCO MAIS RECENTES":
          listaHistorico = recentes
        case "ANTERIORES":
          listaHistorico = anteriores
    selecionado = choose(listaHistorico)
    partesSelecionado = text.detect(input: selecionado)
    nomeSelecionado = combine(partesSelecionado, separator: "")
    arquivosLidos = files.open(folder: pastaLeitura, path: nomeSelecionado, error_if_missing: true, show_picker: false)
    arquivoLidoBruto = item(arquivosLidos, at: 1)
    arquivoLido = as_type(arquivoLidoBruto, "File")
    hashesLidos = data.hash(input: arquivoLido, algorithm: "SHA256")
    ultimoHash = combine(hashesLidos, separator: "")
    partesLidas = text.detect(input: arquivoLido)
    ultimoJson = combine(partesLidas, separator: "")
    bruto = data.decode_json(input: ultimoJson)
    sessaoLida = as_type(bruto, "Dictionary")
    campoBruto_1 = data.lookup(input: sessaoLida, dictionary_key: "versao")
    versao = ""
    if campoBruto_1 has value:
      campoPartes_1 = text.detect(input: campoBruto_1)
      versao = combine(campoPartes_1, separator: "")
    campoBruto_2 = data.lookup(input: sessaoLida, dictionary_key: "id")
    identificador = ""
    if campoBruto_2 has value:
      campoPartes_2 = text.detect(input: campoBruto_2)
      identificador = combine(campoPartes_2, separator: "")
    campoBruto_3 = data.lookup(input: sessaoLida, dictionary_key: "inicio")
    inicio = ""
    if campoBruto_3 has value:
      campoPartes_3 = text.detect(input: campoBruto_3)
      inicio = combine(campoPartes_3, separator: "")
    campoBruto_4 = data.lookup(input: sessaoLida, dictionary_key: "estado")
    estado = ""
    if campoBruto_4 has value:
      campoPartes_4 = text.detect(input: campoBruto_4)
      estado = combine(campoPartes_4, separator: "")
    campoBruto_5 = data.lookup(input: sessaoLida, dictionary_key: "origem")
    origem = ""
    if campoBruto_5 has value:
      campoPartes_5 = text.detect(input: campoBruto_5)
      origem = combine(campoPartes_5, separator: "")
    if versao != "5":
      alert("Selecione uma conferencia V5. Os arquivos V3/V4 nao serao alterados.", title: "Formato diferente")
      flow.stop()
    idsValidos = match(identificador, pattern: "^[0-9_-]{19,40}$")
    numeroIds = count(idsValidos)
    condicaoAlternativa_1 = "NAO"
    if numeroIds != 1:
      condicaoAlternativa_1 = "SIM"
    if inicio is empty:
      condicaoAlternativa_1 = "SIM"
    if condicaoAlternativa_1 == "SIM":
      alert("Identificador ou data invalidos. Tente recuperar o backup.", title: "Arquivo invalido")
      flow.stop()
    if estado != "ABERTA":
      if estado != "FINALIZADA":
        alert("Estado desconhecido. Tente recuperar o backup.", title: "Arquivo invalido")
        flow.stop()
    nomeEsperado = text("Conferencia_\(identificador).json")
    if nomeSelecionado != "\(nomeEsperado)":
      alert("O nome do arquivo nao corresponde ao identificador interno.", title: "Arquivo invalido")
      flow.stop()
    nomeSessao = nomeEsperado
    cadastroSalvo = sessaoLida["cadastro"]
    if cadastroSalvo has no value:
      alert("A conferencia nao tem sua copia do cadastro.", title: "Arquivo invalido")
      flow.stop()
    cadastro = as_type(cadastroSalvo, "Dictionary")
    chavesSessao = data.lookup(input: sessaoLida, get_dictionary_value_type: "All Keys")
    temRegistros = "NAO"
    if chavesSessao has value:
      for item in chavesSessao:
        partesChave = text.detect(input: item)
        chaveSessao = combine(partesChave, separator: "")
        if chaveSessao == "registros":
          temRegistros = "SIM"
    if temRegistros != "SIM":
      alert("O arquivo perdeu a chave registros. Tente recuperar o backup.", title: "Arquivo invalido")
      flow.stop()
    registrosSalvos = sessaoLida["registros"]
    if registrosSalvos has value:
      registros = as_type(registrosSalvos, "Dictionary")
    if modo == "CONTINUAR":
      if estado == "FINALIZADA":
        alert("Conferencia encerrada. Use Gerar resumo para consulta.", title: "Somente leitura")
        flow.stop()
    if recuperar == "NAO":
      arquivoPrincipal = arquivoLido
    if recuperar == "SIM":
      origem = identificador
      identificador = ""
      ultimoJson = ""
      ultimoHash = ""
      precisaSalvar = "SIM"
      operacao = "INICIAR"
    if modo == "RESUMO":
      operacao = "RESUMO"

  if identificador is empty:
    agora_1 = dates.value(date_action_mode: "Current Date")
    dataPartes_1 = dates.format(date: agora_1, date_style: "Custom", date_format: "yyyy-MM-dd_HH-mm-ss-SSS")
    dataId = combine(dataPartes_1, separator: "")
    datasValidas_dataId = match(dataId, pattern: "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{3}$")
    totalDatas_dataId = count(datasValidas_dataId)
    if totalDatas_dataId != 1:
      alert("A data/hora nao foi produzida corretamente. Nenhum arquivo com nome incompleto sera criado. Informe este erro.", title: "Data indisponivel")
      flow.stop()
    aleatorio = random(100000, 999999)
    identificador = text("\(dataId)-\(aleatorio)")
    nomeSessao = text("Conferencia_\(identificador).json")
    if inicio is empty:
      inicio = dataId

  itensBrutos = cadastro["itens"]
  if itensBrutos has no value:
    alert("O cadastro esta sem produtos.", title: "Cadastro invalido")
    flow.stop()
  itensCadastro = require(itensBrutos, message: "Lista de produtos presente apos verificacao")
  quantidadeProdutos = count(itensCadastro)
  if quantidadeProdutos != 60:
    alert("Esperados os 60 produtos originais. Nenhum cadastro sera alterado.", title: "Cadastro invalido")
    flow.stop()
  idsVistos = data({})
  for item in itensCadastro:
    produto = as_type(item, "Dictionary")
    campoBruto_6 = data.lookup(input: produto, dictionary_key: "id")
    idProduto = ""
    if campoBruto_6 has value:
      campoPartes_6 = text.detect(input: campoBruto_6)
      idProduto = combine(campoPartes_6, separator: "")
    campoBruto_7 = data.lookup(input: produto, dictionary_key: "nome")
    nomeProduto = ""
    if campoBruto_7 has value:
      campoPartes_7 = text.detect(input: campoBruto_7)
      nomeProduto = combine(campoPartes_7, separator: "")
    campoBruto_8 = data.lookup(input: referencia, dictionary_key: idProduto)
    esperado = ""
    if campoBruto_8 has value:
      campoPartes_8 = text.detect(input: campoBruto_8)
      esperado = combine(campoPartes_8, separator: "")
    if esperado is empty:
      alert("Nao foi encontrado o ID lido.\nID lido: [\(idProduto)]\nNome lido: [\(nomeProduto)]\nNenhum registro foi gravado. O cadastro original foi preservado.", title: "Diagnostico do cadastro")
      flow.stop()
    if nomeProduto != "\(esperado)":
      alert("A comparacao dos nomes divergiu.\nID: [\(idProduto)]\nNome lido: [\(nomeProduto)]\nNome esperado: [\(esperado)]\nNenhum registro foi gravado. O cadastro original foi preservado.", title: "Diagnostico do cadastro")
      flow.stop()
    idRepetido = data.lookup(input: idsVistos, dictionary_key: idProduto)
    if idRepetido has value:
      alert("O cadastro possui IDs repetidos.", title: "Cadastro invalido")
      flow.stop()
    idsVistos = data.set_value(dictionary: idsVistos, key: idProduto, value: "SIM")

  if modo == "NOVA":
    alert("1/3 - Cadastro validado. Os 60 produtos foram lidos. Toque OK para preparar o arquivo da conferencia.", title: "Teste V5.5", cancel: false)

  # Conferencias novas comecam vazias; validar registros somente ao reabrir.
  if modo != "NOVA":
    # Validate stored rows once, without regenerating the original catalog.
    for item in ordem:
      partesId = text.detect(input: item)
      idLinha = combine(partesId, separator: "")
      campoBruto_9 = data.lookup(input: registros, dictionary_key: idLinha)
      textoLinha = ""
      if campoBruto_9 has value:
        campoPartes_9 = text.detect(input: campoBruto_9)
        textoLinha = combine(campoPartes_9, separator: "")
      if textoLinha is not empty:
        linhaBruta = data.decode_json(input: textoLinha)
        linha = as_type(linhaBruta, "Dictionary")
        campoBruto_10 = data.lookup(input: linha, dictionary_key: "estoque")
        estoqueLinha = ""
        if campoBruto_10 has value:
          campoPartes_10 = text.detect(input: campoBruto_10)
          estoqueLinha = combine(campoPartes_10, separator: "")
        campoBruto_11 = data.lookup(input: linha, dictionary_key: "comprar")
        compraLinha = ""
        if campoBruto_11 has value:
          campoPartes_11 = text.detect(input: campoBruto_11)
          compraLinha = combine(campoPartes_11, separator: "")
        campoBruto_12 = data.lookup(input: linha, dictionary_key: "processar")
        processoLinha = ""
        if campoBruto_12 has value:
          campoPartes_12 = text.detect(input: campoBruto_12)
          processoLinha = combine(campoPartes_12, separator: "")
        valoresLinha = text("\(estoqueLinha)|\(compraLinha)|\(processoLinha)")
        linhasValidas = match(valoresLinha, pattern: "^[0-9]{1,9}\\|[0-9]{1,9}\\|[0-9]{1,9}$")
        numeroLinhas = count(linhasValidas)
        if numeroLinhas != 1:
          alert("Um registro possui quantidades invalidas. Tente recuperar o backup.", title: "Arquivo invalido")
          flow.stop()
        totalConferidos = totalConferidos + 1
    chavesRegistros = data.lookup(input: registros, get_dictionary_value_type: "All Keys")
    numeroChaves = 0
    if chavesRegistros has value:
      numeroChaves = count(chavesRegistros)
    if numeroChaves != totalConferidos:
      alert("Existem registros desconhecidos ou vazios. Tente recuperar o backup.", title: "Arquivo invalido")
      flow.stop()

  idAtual = ""
  cursor = 1
  # Native repeats are bounded; pause/finalize stop immediately, without recursion.
  repeat 1000 times:
    if operacao == "MENU":
      pendente = ""
      primeiroPendente = ""
      indicePendente = 1
      primeiroIndice = 1
      indice = 0
      for item in ordem:
        indice = indice + 1
        partesId = text.detect(input: item)
        idCandidato = combine(partesId, separator: "")
        if pendente is empty:
          campoBruto_13 = data.lookup(input: registros, dictionary_key: idCandidato)
          registroCandidato = ""
          if campoBruto_13 has value:
            campoPartes_13 = text.detect(input: campoBruto_13)
            registroCandidato = combine(campoPartes_13, separator: "")
          if registroCandidato is empty:
            if primeiroPendente is empty:
              primeiroPendente = idCandidato
              primeiroIndice = indice
            if indice >= cursor:
              pendente = idCandidato
              indicePendente = indice
      if pendente is empty:
        pendente = primeiroPendente
        indicePendente = primeiroIndice
      faltam = 60 - totalConferidos
      campoBruto_14 = data.lookup(input: referencia, dictionary_key: pendente)
      proximoNome = ""
      if campoBruto_14 has value:
        campoPartes_14 = text.detect(input: campoBruto_14)
        proximoNome = combine(campoPartes_14, separator: "")
      if pendente is empty:
        proximoNome = "Todos conferidos"
      menu("\(totalConferidos)/60 | Proximo: \(proximoNome)"):
        case "PRÓXIMO ITEM":
          operacao = "CONFERIR"
        case "DEIXAR PRÓXIMO PARA DEPOIS":
          operacao = "PULAR"
        case "REVISAR ITEM":
          operacao = "REVISAR"
        case "PAUSAR":
          operacao = "PAUSAR"
        case "FINALIZAR":
          operacao = "CONFIRMAR FIM"
      idAtual = pendente
      if operacao == "PULAR":
        if pendente is not empty:
          cursor = indicePendente + 1
        operacao = "MENU"
      if operacao == "CONFERIR":
        if pendente is empty:
          alert("Todos os itens foram conferidos. Voce pode revisar ou finalizar.", title: "Conferencia completa")
          operacao = "MENU"
        else:
          cursor = indicePendente + 1
      if operacao == "REVISAR":
        nomeEscolhido = choose(nomesOrdenados)
        partesNome = text.detect(input: nomeEscolhido)
        nomeAtual = combine(partesNome, separator: "")
        indice = 0
        for item in nomesOrdenados:
          indice = indice + 1
          partesNome = text.detect(input: item)
          candidatoNome = combine(partesNome, separator: "")
          if candidatoNome == "\(nomeAtual)":
            idEscolhido = item(ordem, at: indice)
            partesId = text.detect(input: idEscolhido)
            idAtual = combine(partesId, separator: "")
        operacao = "CONFERIR"
      if operacao == "CONFIRMAR FIM":
        menu("Encerrar definitivamente? Faltam \(faltam) itens. A consulta continuara disponivel."):
          case "SIM, ENCERRAR":
            operacao = "FINALIZAR"
            estado = "FINALIZADA"
            precisaSalvar = "SIM"
          case "VOLTAR":
            operacao = "MENU"

    if operacao == "CONFERIR":
      campoBruto_15 = data.lookup(input: referencia, dictionary_key: idAtual)
      nomeAtual = ""
      if campoBruto_15 has value:
        campoPartes_15 = text.detect(input: campoBruto_15)
        nomeAtual = combine(campoPartes_15, separator: "")
      campoBruto_16 = data.lookup(input: registros, dictionary_key: idAtual)
      anteriorTexto = ""
      if campoBruto_16 has value:
        campoPartes_16 = text.detect(input: campoBruto_16)
        anteriorTexto = combine(campoPartes_16, separator: "")
      estoqueAnterior = "0"
      compraAnterior = "0"
      processoAnterior = "0"
      if anteriorTexto is not empty:
        anteriorBruto = data.decode_json(input: anteriorTexto)
        anterior = as_type(anteriorBruto, "Dictionary")
        campoBruto_17 = data.lookup(input: anterior, dictionary_key: "estoque")
        estoqueAnterior = ""
        if campoBruto_17 has value:
          campoPartes_17 = text.detect(input: campoBruto_17)
          estoqueAnterior = combine(campoPartes_17, separator: "")
        campoBruto_18 = data.lookup(input: anterior, dictionary_key: "comprar")
        compraAnterior = ""
        if campoBruto_18 has value:
          campoPartes_18 = text.detect(input: campoBruto_18)
          compraAnterior = combine(campoPartes_18, separator: "")
        campoBruto_19 = data.lookup(input: anterior, dictionary_key: "processar")
        processoAnterior = ""
        if campoBruto_19 has value:
          campoPartes_19 = text.detect(input: campoBruto_19)
          processoAnterior = combine(campoPartes_19, separator: "")
      estoque = input.ask(type: "Text", prompt: "\(nomeAtual) | Estoque atual", default: estoqueAnterior, multiline: false)
      digitos_2 = match(estoque, pattern: "^[0-9]{1,9}$")
      numeroDigitos_2 = count(digitos_2)
      if numeroDigitos_2 != 1:
        alert("Use um inteiro de 0 a 999999999. O item atual nao foi gravado; os anteriores permanecem salvos.", title: "Quantidade invalida")
        flow.stop()
      compra = input.ask(type: "Text", prompt: "\(nomeAtual) | Quantidade para COMPRAR (0 = nenhuma)", default: compraAnterior, multiline: false)
      digitos_3 = match(compra, pattern: "^[0-9]{1,9}$")
      numeroDigitos_3 = count(digitos_3)
      if numeroDigitos_3 != 1:
        alert("Use um inteiro de 0 a 999999999. O item atual nao foi gravado; os anteriores permanecem salvos.", title: "Quantidade invalida")
        flow.stop()
      processo = input.ask(type: "Text", prompt: "\(nomeAtual) | Quantidade para PROCESSAR (0 = nenhuma)", default: processoAnterior, multiline: false)
      digitos_4 = match(processo, pattern: "^[0-9]{1,9}$")
      numeroDigitos_4 = count(digitos_4)
      if numeroDigitos_4 != 1:
        alert("Use um inteiro de 0 a 999999999. O item atual nao foi gravado; os anteriores permanecem salvos.", title: "Quantidade invalida")
        flow.stop()
      linhaJson = text("{\"estoque\":\"\(estoque)\",\"comprar\":\"\(compra)\",\"processar\":\"\(processo)\"}")
      registros = data.set_value(dictionary: registros, key: idAtual, value: linhaJson)
      if anteriorTexto is empty:
        totalConferidos = totalConferidos + 1
      precisaSalvar = "SIM"

    # One checkpoint for initial creation, each completed item and finalization.
    if precisaSalvar == "SIM":
      sessao = data({"versao": 5, "id": identificador, "inicio": inicio, "estado": estado, "origem": origem, "cadastro": cadastro, "registros": registros})
      partesJson = text.detect(input: sessao)
      novoJson = combine(partesJson, separator: "")
      testeBruto = data.decode_json(input: novoJson)
      teste = as_type(testeBruto, "Dictionary")
      campoBruto_20 = data.lookup(input: teste, dictionary_key: "id")
      idTeste = ""
      if campoBruto_20 has value:
        campoPartes_20 = text.detect(input: campoBruto_20)
        idTeste = combine(campoPartes_20, separator: "")
      if idTeste != "\(identificador)":
        alert("A serializacao JSON nao preservou o identificador. Nada sera gravado.", title: "JSON invalido")
        flow.stop()
      if operacao == "INICIAR":
        alert("2/3 - JSON preparado. Toque OK para gravar o arquivo inicial no iCloud Drive.", title: "Teste V5.5", cancel: false)
      substituir = false
      if arquivoPrincipal has value:
        arquivoConfirmado = as_type(arquivoPrincipal, "File")
        hashesAtuais = data.hash(input: arquivoConfirmado, algorithm: "SHA256")
        hashAtual = combine(hashesAtuais, separator: "")
        if hashAtual != "\(ultimoHash)":
          alert("O principal mudou desde a leitura, ou houve colisao de nome. Nenhum arquivo sera sobrescrito. Retome a versao atual.", title: "Conflito")
          flow.stop()
        convertidos_5 = files.convert(input: ultimoJson, type: "public.plain-text")
        convertido_5 = item(convertidos_5, at: 1)
        nomeado_5 = files.rename(item: convertido_5, name: nomeSessao, exclude_extension: false)
        arquivoNomeado_5 = as_type(nomeado_5, "File")
        salvos_5 = files.save(item: arquivoNomeado_5, folder: backups, destination: nomeSessao, ask_where: false, overwrite: true)
        backupGravado = item(salvos_5, at: 1)
        extensaoBruta_5 = files.detail(file: backupGravado, property: "File Extension")
        extensaoPartes_5 = text.detect(input: extensaoBruta_5)
        extensaoSalva_5 = combine(extensaoPartes_5, separator: "")
        if extensaoSalva_5 != "json":
          alert("Extensao inesperada: [\(extensaoSalva_5)]. Esperada: json. Pare, preserve os arquivos e informe esta mensagem.", title: "Nome do arquivo")
          flow.stop()
        partesRelidas_5 = text.detect(input: backupGravado)
        relido_5 = combine(partesRelidas_5, separator: "")
        if relido_5 != "\(ultimoJson)":
          alert("O texto relido divergiu do gravado. Pare e use a recuperacao por backup; nao continue gravando.", title: "Falha de gravacao")
          flow.stop()
        substituir = true
      else:
        if ultimoHash is not empty:
          alert("A referencia do principal nao esta disponivel. A conferencia nao sera sobrescrita; reabra o arquivo ou recupere o backup.", title: "Referencia indisponivel")
          flow.stop()
        # Somente na criacao: impedir substituicao de uma conferencia anterior.
        existentes = files.contents(folder: pasta)
        for item in existentes:
          partesNome = files.name(item: item)
          nomeExistente = combine(partesNome, separator: "")
          if nomeExistente == "\(nomeSessao)":
            alert("Ja existe um arquivo com este nome. Inicie outra conferencia; nada sera sobrescrito.", title: "Conflito de nome")
            flow.stop()
      convertidos_6 = files.convert(input: novoJson, type: "public.plain-text")
      convertido_6 = item(convertidos_6, at: 1)
      nomeado_6 = files.rename(item: convertido_6, name: nomeSessao, exclude_extension: false)
      arquivoNomeado_6 = as_type(nomeado_6, "File")
      salvos_6 = files.save(item: arquivoNomeado_6, folder: pasta, destination: nomeSessao, ask_where: false, overwrite: substituir)
      principalGravado = item(salvos_6, at: 1)
      extensaoBruta_6 = files.detail(file: principalGravado, property: "File Extension")
      extensaoPartes_6 = text.detect(input: extensaoBruta_6)
      extensaoSalva_6 = combine(extensaoPartes_6, separator: "")
      if extensaoSalva_6 != "json":
        alert("Extensao inesperada: [\(extensaoSalva_6)]. Esperada: json. Pare, preserve os arquivos e informe esta mensagem.", title: "Nome do arquivo")
        flow.stop()
      partesRelidas_6 = text.detect(input: principalGravado)
      relido_6 = combine(partesRelidas_6, separator: "")
      if relido_6 != "\(novoJson)":
        alert("O texto relido divergiu do gravado. Pare e use a recuperacao por backup; nao continue gravando.", title: "Falha de gravacao")
        flow.stop()
      ultimoJson = novoJson
      hashesGravados = data.hash(input: principalGravado, algorithm: "SHA256")
      ultimoHash = combine(hashesGravados, separator: "")
      arquivoPrincipal = principalGravado
      precisaSalvar = "NAO"
      if operacao == "INICIAR":
        alert("3/3 - Arquivo inicial salvo e relido. Toque OK para abrir o menu dos produtos.", title: "Teste V5.5", cancel: false)

    if operacao == "PAUSAR":
      alert("Conferencia salva. Use Continuar conferencia para retomar no primeiro item nao conferido.", title: "Pausada")
      flow.stop()

    condicaoAlternativa_2 = "NAO"
    if operacao == "RESUMO":
      condicaoAlternativa_2 = "SIM"
    if operacao == "FINALIZAR":
      condicaoAlternativa_2 = "SIM"
    if condicaoAlternativa_2 == "SIM":
      linhas = ""
      naoConferidos = ""
      compras = ""
      processos = ""
      for item in ordem:
        partesId = text.detect(input: item)
        idResumo = combine(partesId, separator: "")
        campoBruto_21 = data.lookup(input: referencia, dictionary_key: idResumo)
        nomeResumoItem = ""
        if campoBruto_21 has value:
          campoPartes_21 = text.detect(input: campoBruto_21)
          nomeResumoItem = combine(campoPartes_21, separator: "")
        escapeA_7 = replace(nomeResumoItem, "&", with: "&amp;")
        escapeB_7 = combine(escapeA_7, separator: "")
        escapeC_7 = replace(escapeB_7, "<", with: "&lt;")
        escapeD_7 = combine(escapeC_7, separator: "")
        escapeE_7 = replace(escapeD_7, ">", with: "&gt;")
        nomeHtml = combine(escapeE_7, separator: "")
        campoBruto_22 = data.lookup(input: registros, dictionary_key: idResumo)
        registroTexto = ""
        if campoBruto_22 has value:
          campoPartes_22 = text.detect(input: campoBruto_22)
          registroTexto = combine(campoPartes_22, separator: "")
        estoqueResumo = ""
        compraResumo = ""
        processoResumo = ""
        conferido = "N"
        if registroTexto is not empty:
          registroBruto = data.decode_json(input: registroTexto)
          registro = as_type(registroBruto, "Dictionary")
          campoBruto_23 = data.lookup(input: registro, dictionary_key: "estoque")
          estoqueResumo = ""
          if campoBruto_23 has value:
            campoPartes_23 = text.detect(input: campoBruto_23)
            estoqueResumo = combine(campoPartes_23, separator: "")
          campoBruto_24 = data.lookup(input: registro, dictionary_key: "comprar")
          compraResumo = ""
          if campoBruto_24 has value:
            campoPartes_24 = text.detect(input: campoBruto_24)
            compraResumo = combine(campoPartes_24, separator: "")
          campoBruto_25 = data.lookup(input: registro, dictionary_key: "processar")
          processoResumo = ""
          if campoBruto_25 has value:
            campoPartes_25 = text.detect(input: campoBruto_25)
            processoResumo = combine(campoPartes_25, separator: "")
          conferido = "S"
          compraNumero = as_type(compraResumo, "Number")
          processoNumero = as_type(processoResumo, "Number")
          if compraNumero > 0:
            compras = text("\(compras)<li>\(nomeHtml): \(compraResumo)</li>")
          if processoNumero > 0:
            processos = text("\(processos)<li>\(nomeHtml): \(processoResumo)</li>")
        else:
          naoConferidos = text("\(naoConferidos)<li>\(nomeHtml)</li>")
        linhas = text("\(linhas)<tr><td>\(nomeHtml)</td><td>\(estoqueResumo)</td><td>\(conferido)</td><td>\(compraResumo)</td><td>\(processoResumo)</td></tr>")
      if naoConferidos is empty:
        naoConferidos = "<li>Nenhum.</li>"
      if compras is empty:
        compras = "<li>Nenhum.</li>"
      if processos is empty:
        processos = "<li>Nenhum.</li>"
      escapeA_8 = replace(inicio, "&", with: "&amp;")
      escapeB_8 = combine(escapeA_8, separator: "")
      escapeC_8 = replace(escapeB_8, "<", with: "&lt;")
      escapeD_8 = combine(escapeC_8, separator: "")
      escapeE_8 = replace(escapeD_8, ">", with: "&gt;")
      inicioHtml = combine(escapeE_8, separator: "")
      escapeA_9 = replace(estado, "&", with: "&amp;")
      escapeB_9 = combine(escapeA_9, separator: "")
      escapeC_9 = replace(escapeB_9, "<", with: "&lt;")
      escapeD_9 = combine(escapeC_9, separator: "")
      escapeE_9 = replace(escapeD_9, ">", with: "&gt;")
      estadoHtml = combine(escapeE_9, separator: "")
      html = text("<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>PAPA PIZZA</title><style>body{font:16px -apple-system,Arial,sans-serif;margin:16px;color:#222}table{border-collapse:collapse;width:100%;font-size:14px}th,td{border:1px solid #ccc;padding:8px;text-align:left}th{background:#eee}.tabela{overflow-x:auto}h2{margin-top:28px}</style></head><body><h1>PAPA PIZZA</h1><p>Inicio: \(inicioHtml) | Estado: \(estadoHtml)</p><p>Conferidos: \(totalConferidos)/60. Zero = nenhuma pendencia. Branco = nao conferido.</p><div class='tabela'><table><thead><tr><th>Item</th><th>Estoque atual</th><th>Conferido?</th><th>Qtd. comprar</th><th>Qtd. processar</th></tr></thead><tbody>\(linhas)</tbody></table></div><h2>Nao conferidos</h2><ul>\(naoConferidos)</ul><h2>Comprar</h2><ul>\(compras)</ul><h2>Processar</h2><ul>\(processos)</ul></body></html>")
      agora_10 = dates.value(date_action_mode: "Current Date")
      dataPartes_10 = dates.format(date: agora_10, date_style: "Custom", date_format: "yyyy-MM-dd_HH-mm-ss-SSS")
      dataResumo = combine(dataPartes_10, separator: "")
      datasValidas_dataResumo = match(dataResumo, pattern: "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{3}$")
      totalDatas_dataResumo = count(datasValidas_dataResumo)
      if totalDatas_dataResumo != 1:
        alert("A data/hora nao foi produzida corretamente. Nenhum arquivo com nome incompleto sera criado. Informe este erro.", title: "Data indisponivel")
        flow.stop()
      numeroResumo = random(100000, 999999)
      nomeHtmlArquivo = text("Resumo_\(identificador)_\(dataResumo)_\(numeroResumo).html")
      convertidos_11 = files.convert(input: html, type: "public.plain-text")
      convertido_11 = item(convertidos_11, at: 1)
      nomeado_11 = files.rename(item: convertido_11, name: nomeHtmlArquivo, exclude_extension: false)
      arquivoNomeado_11 = as_type(nomeado_11, "File")
      salvos_11 = files.save(item: arquivoNomeado_11, folder: resumos, destination: nomeHtmlArquivo, ask_where: false, overwrite: false)
      arquivoHtml = item(salvos_11, at: 1)
      extensaoBruta_11 = files.detail(file: arquivoHtml, property: "File Extension")
      extensaoPartes_11 = text.detect(input: extensaoBruta_11)
      extensaoSalva_11 = combine(extensaoPartes_11, separator: "")
      if extensaoSalva_11 != "html":
        alert("Extensao inesperada: [\(extensaoSalva_11)]. Esperada: html. Pare, preserve os arquivos e informe esta mensagem.", title: "Nome do arquivo")
        flow.stop()
      partesRelidas_11 = text.detect(input: arquivoHtml)
      relido_11 = combine(partesRelidas_11, separator: "")
      if relido_11 != "\(html)":
        alert("O texto relido divergiu do gravado. Pare e use a recuperacao por backup; nao continue gravando.", title: "Falha de gravacao")
        flow.stop()
      preview.show(item: arquivoHtml)
      flow.stop()
    operacao = "MENU"
  alert("Limite de interacoes desta execucao atingido. O progresso ja foi salvo; use Continuar conferencia.", title: "Pausada")
