      "name": "Main.shortcuty",
      "contents": "# PAPA PIZZA V5 — fluxo alfabetico; Check/Build nao executam no iPhone.\n# IDs/ordem gerados do cadastro original; o JSON original e somente leitura.\ndef campo(dicionario: Dictionary, chave: Text) -> Text:\n  bruto = data.lookup(input: dicionario, dictionary_key: chave)\n  resultado = \"\"\n  if bruto has value:\n    partes = text.detect(input: bruto)\n    resultado = combine(partes, separator: \"\")\n  return resultado\n\ndef instante() -> Text:\n  atual = now()\n  partes = dates.format(date: atual, date_style: \"Custom\", date_format: \"yyyy-MM-dd_HH-mm-ss-SSS\")\n  return combine(partes, separator: \"\")\n\ndef quantidade(pergunta: Text, anterior: Text) -> Text:\n  resposta = input.ask(type: \"Text\", prompt: pergunta, default: anterior, multiline: false)\n  validos = match(resposta, pattern: \"^[0-9]{1,9}$\")\n  numero = count(validos)\n  if numero != 1:\n    alert(\"Use um inteiro de 0 a 999999999. As respostas deste item nao foram gravadas. Os itens anteriores permanecem salvos.\", title: \"Quantidade invalida\")\n    flow.stop()\n  return resposta\n\ndef gravar(conteudo: Text, pasta: File, nome: Text, substituir: Boolean) -> File:\n  convertidos = files.convert(input: conteudo, type: \"public.plain-text\")\n  convertido = item(convertidos, at: 1)\n  salvos = files.save(item: convertido, folder: pasta, destination: nome, ask_where: false, overwrite: substituir)\n  salvo = item(salvos, at: 1)\n  partes = text.detect(input: salvo)\n  relido = combine(partes, separator: \"\")\n  if relido != conteudo:\n    alert(\"O texto relido divergiu do gravado. Pare e use a recuperacao por backup; nao continue gravando.\", title: \"Falha de gravacao\")\n    flow.stop()\n  return salvo\n\ndef escapar(valor: Text) -> Text:\n  a = replace(valor, \"&\", with: \"&amp;\")\n  b = combine(a, separator: \"\")\n  c = replace(b, \"<\", with: \"&lt;\")\n  d = combine(c, separator: \"\")\n  e = replace(d, \">\", with: \"&gt;\")\n  return combine(e, separator: \"\")\n\nshortcut:\n  modo = \"SAIR\"\n  menu(\"PAPA PIZZA | Conferencia\"):\n    case \"NOVA CONFERÊNCIA\":\n      modo = \"NOVA\"\n    case \"CONTINUAR CONFERÊNCIA\":\n      modo = \"CONTINUAR\"\n    case \"GERAR RESUMO\":\n      modo = \"RESUMO\"\n    case \"SAIR\":\n      modo = \"SAIR\"\n  if modo == \"SAIR\":\n    flow.stop()\n\n  pasta = files.create_folder(path: \"PAPA PIZZA/V5/Conferencias\")\n  backups = files.create_folder(path: \"PAPA PIZZA/V5/Backups\")\n  resumos = files.create_folder(path: \"PAPA PIZZA/V5/Resumos\")\n  ordem = list([\"18\", \"53\", \"59\", \"31\", \"12\", \"6\", \"37\", \"38\", \"36\", \"56\", \"55\", \"49\", \"33\", \"32\", \"3\", \"7\", \"24\", \"13\", \"19\", \"25\", \"57\", \"41\", \"44\", \"40\", \"43\", \"47\", \"8\", \"46\", \"26\", \"54\", \"50\", \"5\", \"21\", \"42\", \"45\", \"35\", \"9\", \"34\", \"29\", \"1\", \"2\", \"27\", \"20\", \"48\", \"30\", \"28\", \"17\", \"60\", \"23\", \"11\", \"15\", \"4\", \"22\", \"52\", \"10\", \"14\", \"16\", \"39\", \"51\", \"58\"])\n  nomesOrdenados = list([\"Abacaxi Picado\", \"Açúcar\", \"Álcool\", \"Alho Frito\", \"Alho Poró Fatiado\", \"Bacon Frito\", \"Bobina Grande\", \"Bobina Impressora\", \"Bobina Pequena\", \"Bombril\", \"Bucha\", \"Cachaça\", \"Caixa 30\", \"Caixa 35\", \"Calabresa Fatiada\", \"Carne Seca\", \"Catupiry\", \"Cebola Fatiada\", \"Champignon\", \"Cheddar\", \"Cloro\", \"Coca Normal 1,5\", \"Coca Normal 600\", \"Coca Zero 1,5\", \"Coca Zero 600\", \"Coloral\", \"Costela\", \"Creme de Alho\", \"Creme De Leite\", \"Detergente\", \"Fermento\", \"Frango Temperado\", \"Gorgonzola\", \"Guaraná 1,5\", \"Guaraná 600\", \"Ketchup\", \"Lombo Fatiado\", \"Maionese\", \"Manjericão\", \"Massa\", \"Molho\", \"Molho Barbecue\", \"Muçarela Ralada\", \"Óleo\", \"Orégano\", \"Ovo Cozido\", \"Palmito\", \"Papel Toalha\", \"Parmesão\", \"Pepperoni\", \"Pimentão Picado\", \"Presunto Fatiado\", \"Provolone\", \"Sal\", \"Salaminho\", \"Tomate Picado\", \"Tomate Seco\", \"Touca\", \"Trigo\", \"Veja\"])\n  referencia = data({\"1\": \"Massa\", \"2\": \"Molho\", \"3\": \"Calabresa Fatiada\", \"4\": \"Presunto Fatiado\", \"5\": \"Frango Temperado\", \"6\": \"Bacon Frito\", \"7\": \"Carne Seca\", \"8\": \"Costela\", \"9\": \"Lombo Fatiado\", \"10\": \"Salaminho\", \"11\": \"Pepperoni\", \"12\": \"Alho Poró Fatiado\", \"13\": \"Cebola Fatiada\", \"14\": \"Tomate Picado\", \"15\": \"Pimentão Picado\", \"16\": \"Tomate Seco\", \"17\": \"Palmito\", \"18\": \"Abacaxi Picado\", \"19\": \"Champignon\", \"20\": \"Muçarela Ralada\", \"21\": \"Gorgonzola\", \"22\": \"Provolone\", \"23\": \"Parmesão\", \"24\": \"Catupiry\", \"25\": \"Cheddar\", \"26\": \"Creme De Leite\", \"27\": \"Molho Barbecue\", \"28\": \"Ovo Cozido\", \"29\": \"Manjericão\", \"30\": \"Orégano\", \"31\": \"Alho Frito\", \"32\": \"Caixa 35\", \"33\": \"Caixa 30\", \"34\": \"Maionese\", \"35\": \"Ketchup\", \"36\": \"Bobina Pequena\", \"37\": \"Bobina Grande\", \"38\": \"Bobina Impressora\", \"39\": \"Touca\", \"40\": \"Coca Zero 1,5\", \"41\": \"Coca Normal 1,5\", \"42\": \"Guaraná 1,5\", \"43\": \"Coca Zero 600\", \"44\": \"Coca Normal 600\", \"45\": \"Guaraná 600\", \"46\": \"Creme de Alho\", \"47\": \"Coloral\", \"48\": \"Óleo\", \"49\": \"Cachaça\", \"50\": \"Fermento\", \"51\": \"Trigo\", \"52\": \"Sal\", \"53\": \"Açúcar\", \"54\": \"Detergente\", \"55\": \"Bucha\", \"56\": \"Bombril\", \"57\": \"Cloro\", \"58\": \"Veja\", \"59\": \"Álcool\", \"60\": \"Papel Toalha\"})\n  cadastro = data({})\n  registros = data({})\n  identificador = \"\"\n  inicio = \"\"\n  estado = \"ABERTA\"\n  origem = \"\"\n  nomeSessao = \"\"\n  ultimoJson = \"\"\n  ultimoHash = \"\"\n  recuperar = \"NAO\"\n  precisaSalvar = \"NAO\"\n  operacao = \"MENU\"\n  totalConferidos = 0\n\n  if modo == \"NOVA\":\n    alert(\"Selecione o cadastro original Papa_Pizza.json no iCloud Drive. Ele sera apenas lido.\", title: \"Cadastro\")\n    arquivosCadastro = files.choose(picking_mode: \"Files\", select_multiple: false)\n    arquivoCadastro = item(arquivosCadastro, at: 1)\n    partesCadastro = text.detect(input: arquivoCadastro)\n    textoCadastro = combine(partesCadastro, separator: \"\")\n    cadastroBruto = data.decode_json(input: textoCadastro)\n    cadastro = as_type(cadastroBruto, \"Dictionary\")\n    precisaSalvar = \"SIM\"\n    operacao = \"INICIAR\"\n  else:\n    pastaLeitura = pasta\n    if modo == \"CONTINUAR\":\n      menu(\"Origem da retomada\"):\n        case \"ARQUIVO PRINCIPAL\":\n          recuperar = \"NAO\"\n        case \"RECUPERAR BACKUP\":\n          recuperar = \"SIM\"\n          pastaLeitura = backups\n    arquivosHistorico = files.contents(folder: pastaLeitura)\n    ordenados = files.filter(items: arquivosHistorico, sort_by: \"Name\", order: \"Descending\")\n    recentes = list([])\n    anteriores = list([])\n    quantidadeHistorico = 0\n    for item in ordenados:\n      candidato = item\n      partesNome = files.name(item: candidato)\n      nome = combine(partesNome, separator: \"\")\n      if nome starts with \"Conferencia_\" and nome ends with \".json\":\n        quantidadeHistorico = quantidadeHistorico + 1\n        if quantidadeHistorico <= 5:\n          variables.append(name: \"recentes\", value: nome)\n        else:\n          variables.append(name: \"anteriores\", value: nome)\n    if quantidadeHistorico == 0:\n      alert(\"Nao ha arquivos nesta pasta. O historico das versoes anteriores permanece na pasta antiga.\", title: \"Historico V5\")\n      flow.stop()\n    listaHistorico = recentes\n    if quantidadeHistorico > 5:\n      menu(\"Historico\"):\n        case \"CINCO MAIS RECENTES\":\n          listaHistorico = recentes\n        case \"ANTERIORES\":\n          listaHistorico = anteriores\n    selecionado = choose(listaHistorico)\n    partesSelecionado = text.detect(input: selecionado)\n    nomeSelecionado = combine(partesSelecionado, separator: \"\")\n    arquivosLidos = files.open(folder: pastaLeitura, path: nomeSelecionado, error_if_missing: true)\n    arquivoLidoBruto = item(arquivosLidos, at: 1)\n    arquivoLido = as_type(arquivoLidoBruto, \"File\")\n    hashesLidos = data.hash(input: arquivoLido, algorithm: \"SHA256\")\n    ultimoHash = combine(hashesLidos, separator: \"\")\n    partesLidas = text.detect(input: arquivoLido)\n    ultimoJson = combine(partesLidas, separator: \"\")\n    bruto = data.decode_json(input: ultimoJson)\n    sessaoLida = as_type(bruto, \"Dictionary\")\n    versao = campo(sessaoLida, \"versao\")\n    identificador = campo(sessaoLida, \"id\")\n    inicio = campo(sessaoLida, \"inicio\")\n    estado = campo(sessaoLida, \"estado\")\n    origem = campo(sessaoLida, \"origem\")\n    if versao != \"5\":\n      alert(\"Selecione uma conferencia V5. Os arquivos V3/V4 nao serao alterados.\", title: \"Formato diferente\")\n      flow.stop()\n    idsValidos = match(identificador, pattern: \"^[0-9_-]{19,40}$\")\n    numeroIds = count(idsValidos)\n    if numeroIds != 1 or inicio is empty:\n      alert(\"Identificador ou data invalidos. Tente recuperar o backup.\", title: \"Arquivo invalido\")\n      flow.stop()\n    if estado != \"ABERTA\" and estado != \"FINALIZADA\":\n      alert(\"Estado desconhecido. Tente recuperar o backup.\", title: \"Arquivo invalido\")\n      flow.stop()\n    nomeEsperado = text(\"Conferencia_\\(identificador).json\")\n    if nomeSelecionado != nomeEsperado:\n      alert(\"O nome do arquivo nao corresponde ao identificador interno.\", title: \"Arquivo invalido\")\n      flow.stop()\n    nomeSessao = nomeEsperado\n    cadastroSalvo = sessaoLida[\"cadastro\"]\n    if cadastroSalvo has no value:\n      alert(\"A conferencia nao tem sua copia do cadastro.\", title: \"Arquivo invalido\")\n      flow.stop()\n    cadastro = as_type(cadastroSalvo, \"Dictionary\")\n    chavesSessao = data.lookup(input: sessaoLida, get_dictionary_value_type: \"All Keys\")\n    temRegistros = \"NAO\"\n    if chavesSessao has value:\n      for item in chavesSessao:\n        partesChave = text.detect(input: item)\n        chaveSessao = combine(partesChave, separator: \"\")\n        if chaveSessao == \"registros\":\n          temRegistros = \"SIM\"\n    if temRegistros != \"SIM\":\n      alert(\"O arquivo perdeu a chave registros. Tente recuperar o backup.\", title: \"Arquivo invalido\")\n      flow.stop()\n    registrosSalvos = sessaoLida[\"registros\"]\n    if registrosSalvos has value:\n      registros = as_type(registrosSalvos, \"Dictionary\")\n    if modo == \"CONTINUAR\" and estado == \"FINALIZADA\":\n      alert(\"Conferencia encerrada. Use Gerar resumo para consulta.\", title: \"Somente leitura\")\n      flow.stop()\n    if recuperar == \"SIM\":\n      origem = identificador\n      identificador = \"\"\n      ultimoJson = \"\"\n      ultimoHash = \"\"\n      precisaSalvar = \"SIM\"\n      operacao = \"INICIAR\"\n    if modo == \"RESUMO\":\n      operacao = \"RESUMO\"\n\n  if identificador is empty:\n    dataId = instante()\n    aleatorio = random(100000, 999999)\n    identificador = text(\"\\(dataId)-\\(aleatorio)\")\n    nomeSessao = text(\"Conferencia_\\(identificador).json\")\n    if inicio is empty:\n      inicio = dataId\n\n  itensBrutos = cadastro[\"itens\"]\n  if itensBrutos has no value:\n    alert(\"O cadastro esta sem produtos.\", title: \"Cadastro invalido\")\n    flow.stop()\n  itensCadastro = require(itensBrutos, message: \"Lista de produtos presente apos verificacao\")\n  quantidadeProdutos = count(itensCadastro)\n  if quantidadeProdutos != 60:\n    alert(\"Esperados os 60 produtos originais. Nenhum cadastro sera alterado.\", title: \"Cadastro invalido\")\n    flow.stop()\n  idsVistos = list([])\n  for item in itensCadastro:\n    produto = as_type(item, \"Dictionary\")\n    idProduto = campo(produto, \"id\")\n    nomeProduto = campo(produto, \"nome\")\n    esperado = campo(referencia, idProduto)\n    if esperado is empty or nomeProduto != esperado:\n      alert(\"ID ou nome difere dos 60 produtos originais. Atualize o projeto para mudar o cadastro.\", title: \"Cadastro divergente\")\n      flow.stop()\n    for item in idsVistos:\n      partesVisto = text.detect(input: item)\n      visto = combine(partesVisto, separator: \"\")\n      if visto == idProduto:\n        alert(\"O cadastro possui IDs repetidos.\", title: \"Cadastro invalido\")\n        flow.stop()\n    variables.append(name: \"idsVistos\", value: idProduto)\n\n  # Validate stored rows once, without regenerating the original catalog.\n  for item in ordem:\n    partesId = text.detect(input: item)\n    idLinha = combine(partesId, separator: \"\")\n    textoLinha = campo(registros, idLinha)\n    if textoLinha is not empty:\n      linhaBruta = data.decode_json(input: textoLinha)\n      linha = as_type(linhaBruta, \"Dictionary\")\n      estoqueLinha = campo(linha, \"estoque\")\n      compraLinha = campo(linha, \"comprar\")\n      processoLinha = campo(linha, \"processar\")\n      valoresLinha = text(\"\\(estoqueLinha)|\\(compraLinha)|\\(processoLinha)\")\n      linhasValidas = match(valoresLinha, pattern: \"^[0-9]{1,9}\\\\|[0-9]{1,9}\\\\|[0-9]{1,9}$\")\n      numeroLinhas = count(linhasValidas)\n      if numeroLinhas != 1:\n        alert(\"Um registro possui quantidades invalidas. Tente recuperar o backup.\", title: \"Arquivo invalido\")\n        flow.stop()\n      totalConferidos = totalConferidos + 1\n  chavesRegistros = data.lookup(input: registros, get_dictionary_value_type: \"All Keys\")\n  numeroChaves = 0\n  if chavesRegistros has value:\n    numeroChaves = count(chavesRegistros)\n  if numeroChaves != totalConferidos:\n    alert(\"Existem registros desconhecidos ou vazios. Tente recuperar o backup.\", title: \"Arquivo invalido\")\n    flow.stop()\n\n  idAtual = \"\"\n  cursor = 1\n  # Native repeats are bounded; pause/finalize stop immediately, without recursion.\n  repeat 1000 times:\n    if operacao == \"MENU\":\n      pendente = \"\"\n      primeiroPendente = \"\"\n      indicePendente = 1\n      primeiroIndice = 1\n      indice = 0\n      for item in ordem:\n        indice = indice + 1\n        partesId = text.detect(input: item)\n        idCandidato = combine(partesId, separator: \"\")\n        if pendente is empty:\n          registroCandidato = campo(registros, idCandidato)\n          if registroCandidato is empty:\n            if primeiroPendente is empty:\n              primeiroPendente = idCandidato\n              primeiroIndice = indice\n            if indice >= cursor:\n              pendente = idCandidato\n              indicePendente = indice\n      if pendente is empty:\n        pendente = primeiroPendente\n        indicePendente = primeiroIndice\n      faltam = 60 - totalConferidos\n      proximoNome = campo(referencia, pendente)\n      if pendente is empty:\n        proximoNome = \"Todos conferidos\"\n      menu(\"\\(totalConferidos)/60 | Proximo: \\(proximoNome)\"):\n        case \"PRÓXIMO ITEM\":\n          operacao = \"CONFERIR\"\n        case \"DEIXAR PRÓXIMO PARA DEPOIS\":\n          operacao = \"PULAR\"\n        case \"REVISAR ITEM\":\n          operacao = \"REVISAR\"\n        case \"PAUSAR\":\n          operacao = \"PAUSAR\"\n        case \"FINALIZAR\":\n          operacao = \"CONFIRMAR FIM\"\n      idAtual = pendente\n      if operacao == \"PULAR\":\n        if pendente is not empty:\n          cursor = indicePendente + 1\n        operacao = \"MENU\"\n      if operacao == \"CONFERIR\":\n        if pendente is empty:\n          alert(\"Todos os itens foram conferidos. Voce pode revisar ou finalizar.\", title: \"Conferencia completa\")\n          operacao = \"MENU\"\n        else:\n          cursor = indicePendente + 1\n      if operacao == \"REVISAR\":\n        nomeEscolhido = choose(nomesOrdenados)\n        partesNome = text.detect(input: nomeEscolhido)\n        nomeAtual = combine(partesNome, separator: \"\")\n        indice = 0\n        for item in nomesOrdenados:\n          indice = indice + 1\n          partesNome = text.detect(input: item)\n          candidatoNome = combine(partesNome, separator: \"\")\n          if candidatoNome == nomeAtual:\n            idEscolhido = item(ordem, at: indice)\n            partesId = text.detect(input: idEscolhido)\n            idAtual = combine(partesId, separator: \"\")\n        operacao = \"CONFERIR\"\n      if operacao == \"CONFIRMAR FIM\":\n        menu(\"Encerrar definitivamente? Faltam \\(faltam) itens. A consulta continuara disponivel.\"):\n          case \"SIM, ENCERRAR\":\n            operacao = \"FINALIZAR\"\n            estado = \"FINALIZADA\"\n            precisaSalvar = \"SIM\"\n          case \"VOLTAR\":\n            operacao = \"MENU\"\n\n    if operacao == \"CONFERIR\":\n      nomeAtual = campo(referencia, idAtual)\n      anteriorTexto = campo(registros, idAtual)\n      estoqueAnterior = \"0\"\n      compraAnterior = \"0\"\n      processoAnterior = \"0\"\n      if anteriorTexto is not empty:\n        anteriorBruto = data.decode_json(input: anteriorTexto)\n        anterior = as_type(anteriorBruto, \"Dictionary\")\n        estoqueAnterior = campo(anterior, \"estoque\")\n        compraAnterior = campo(anterior, \"comprar\")\n        processoAnterior = campo(anterior, \"processar\")\n      estoque = quantidade(\"\\(nomeAtual) | Estoque atual\", estoqueAnterior)\n      compra = quantidade(\"\\(nomeAtual) | Quantidade para COMPRAR (0 = nenhuma)\", compraAnterior)\n      processo = quantidade(\"\\(nomeAtual) | Quantidade para PROCESSAR (0 = nenhuma)\", processoAnterior)\n      linhaJson = text(\"{\\\"estoque\\\":\\\"\\(estoque)\\\",\\\"comprar\\\":\\\"\\(compra)\\\",\\\"processar\\\":\\\"\\(processo)\\\"}\")\n      registros = data.set_value(dictionary: registros, key: idAtual, value: linhaJson)\n      if anteriorTexto is empty:\n        totalConferidos = totalConferidos + 1\n      precisaSalvar = \"SIM\"\n\n    # One checkpoint for initial creation, each completed item and finalization.\n    if precisaSalvar == \"SIM\":\n      sessao = data({\"versao\": 5, \"id\": identificador, \"inicio\": inicio, \"estado\": estado, \"origem\": origem, \"cadastro\": cadastro, \"registros\": registros})\n      partesJson = text.detect(input: sessao)\n      novoJson = combine(partesJson, separator: \"\")\n      testeBruto = data.decode_json(input: novoJson)\n      teste = as_type(testeBruto, \"Dictionary\")\n      idTeste = campo(teste, \"id\")\n      if idTeste != identificador:\n        alert(\"A serializacao JSON nao preservou o identificador. Nada sera gravado.\", title: \"JSON invalido\")\n        flow.stop()\n      existentes = files.contents(folder: pasta)\n      arquivoAtual = null\n      for item in existentes:\n        partesNome = files.name(item: item)\n        nomeExistente = combine(partesNome, separator: \"\")\n        if nomeExistente == nomeSessao:\n          arquivoAtual = item\n      substituir = false\n      if arquivoAtual has value:\n        arquivoConfirmado = as_type(arquivoAtual, \"File\")\n        hashesAtuais = data.hash(input: arquivoConfirmado, algorithm: \"SHA256\")\n        hashAtual = combine(hashesAtuais, separator: \"\")\n        if hashAtual != ultimoHash:\n          alert(\"O principal mudou desde a leitura, ou houve colisao de nome. Nenhum arquivo sera sobrescrito. Retome a versao atual.\", title: \"Conflito\")\n          flow.stop()\n        backupGravado = gravar(ultimoJson, backups, nomeSessao, true)\n        substituir = true\n      else:\n        if ultimoHash is not empty:\n          alert(\"O arquivo principal foi removido durante a conferencia. Pare e recupere o backup.\", title: \"Principal ausente\")\n          flow.stop()\n      principalGravado = gravar(novoJson, pasta, nomeSessao, substituir)\n      ultimoJson = novoJson\n      hashesGravados = data.hash(input: principalGravado, algorithm: \"SHA256\")\n      ultimoHash = combine(hashesGravados, separator: \"\")\n      precisaSalvar = \"NAO\"\n\n    if operacao == \"PAUSAR\":\n      alert(\"Conferencia salva. Use Continuar conferencia para retomar no primeiro item nao conferido.\", title: \"Pausada\")\n      flow.stop()\n\n    if operacao == \"RESUMO\" or operacao == \"FINALIZAR\":\n      linhas = \"\"\n      naoConferidos = \"\"\n      compras = \"\"\n      processos = \"\"\n      for item in ordem:\n        partesId = text.detect(input: item)\n        idResumo = combine(partesId, separator: \"\")\n        nomeResumoItem = campo(referencia, idResumo)\n        nomeHtml = escapar(nomeResumoItem)\n        registroTexto = campo(registros, idResumo)\n        estoqueResumo = \"\"\n        compraResumo = \"\"\n        processoResumo = \"\"\n        conferido = \"N\"\n        if registroTexto is not empty:\n          registroBruto = data.decode_json(input: registroTexto)\n          registro = as_type(registroBruto, \"Dictionary\")\n          estoqueResumo = campo(registro, \"estoque\")\n          compraResumo = campo(registro, \"comprar\")\n          processoResumo = campo(registro, \"processar\")\n          conferido = \"S\"\n          compraNumero = as_type(compraResumo, \"Number\")\n          processoNumero = as_type(processoResumo, \"Number\")\n          if compraNumero > 0:\n            compras = text(\"\\(compras)<li>\\(nomeHtml): \\(compraResumo)</li>\")\n          if processoNumero > 0:\n            processos = text(\"\\(processos)<li>\\(nomeHtml): \\(processoResumo)</li>\")\n        else:\n          naoConferidos = text(\"\\(naoConferidos)<li>\\(nomeHtml)</li>\")\n        linhas = text(\"\\(linhas)<tr><td>\\(nomeHtml)</td><td>\\(estoqueResumo)</td><td>\\(conferido)</td><td>\\(compraResumo)</td><td>\\(processoResumo)</td></tr>\")\n      if naoConferidos is empty:\n        naoConferidos = \"<li>Nenhum.</li>\"\n      if compras is empty:\n        compras = \"<li>Nenhum.</li>\"\n      if processos is empty:\n        processos = \"<li>Nenhum.</li>\"\n      inicioHtml = escapar(inicio)\n      estadoHtml = escapar(estado)\n      html = text(\"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-